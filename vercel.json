{
  "cleanUrls": true,
  "functions": {
    "api/site.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site"
    }
  ],
  "headers": [
    {
      "source": "/content.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
